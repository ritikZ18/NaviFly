# Airtable sync — copy this file to `.env` (already gitignored) and fill in.
# Do NOT commit `.env`.

# Personal Access Token — create at https://airtable.com/create/tokens
# Scopes required:  schema.bases:read  +  data.records:read
# Access:           add your base to the token's access list
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX

# Base ID — the "app..." id. Find it at https://airtable.com/developers/web/api/introduction
# (pick your base) or in the base URL: airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Optional — only if your tables aren't named exactly these (I'll confirm from your schema)
AIRTABLE_SCHOOLS_TABLE=Schools
AIRTABLE_PROGRAMS_TABLE=Programs
